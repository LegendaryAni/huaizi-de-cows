.DS_Store
.venv/
__pycache__/
.godot/
*.uid

# Ignore generated/local validation output.
/assets/audio/scifi/*.import
reports/*

assets/source/*.import
assets/sprites/*.import
assets/sprites/**/*.import
assets/sprites/previews/*.import
spec/*.png.import
/tools/
/Tools/

# v0.2 reproducible asset processing and independent acceptance runner.
!/tools/
/tools/*
!/tools/prepare_scifi_art.py
!/tools/run_scifi_tests.ps1
!/tools/build_1103_mech_layers.py
!/tools/build_scifi_world.py
!/tools/build_legendaryani_art.py
!/tools/verify_runtime_assets.py
!/tools/run_sf16_growth.ps1
!/tools/analyze_sf16_growth.py
!/tools/test_analyze_sf16_growth.py

# Local validation, restore points, and exported previews must never be committed.
/.codex/builds/
/.codex/restorepoints/
/.codex/validation/
/.codex/*.png
